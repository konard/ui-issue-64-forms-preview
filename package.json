{
  "name": "@link-foundation/ui",
  "version": "0.11.31",
  "description": "Associative UI framework whose documents, configuration, styles and animations are written in Links Notation",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "src/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 tests/*.test.js",
    "lint": "node scripts/lint.mjs",
    "lint:all": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:duplication": "jscpd .",
    "check:assets": "node scripts/check-assets.mjs",
    "assets:attributions": "node scripts/render-attributions.mjs",
    "check": "npm run lint && npm run format:check && npm run check:duplication",
    "example:web:dev": "npm --prefix examples/universal-app run dev",
    "example:web:build": "npm --prefix examples/universal-app run build",
    "example:web:preview": "npm --prefix examples/universal-app run preview",
    "example:web:preview-images": "node scripts/update-preview-images.mjs",
    "example:desktop:package": "npm --prefix examples/universal-app run desktop:package",
    "example:desktop:make": "npm --prefix examples/universal-app run desktop:make",
    "example:mobile:sync": "npm --prefix examples/universal-app run mobile:sync",
    "prepare": "node scripts/install-git-hooks.mjs",
    "changeset": "changeset",
    "changeset:version": "node scripts/changeset-version.mjs",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since=origin/main"
  },
  "keywords": [
    "ui",
    "links-notation",
    "associative",
    "design-system",
    "wysiwyg"
  ],
  "author": "",
  "license": "Unlicense",
  "devEngines": {
    "packageManager": {
      "name": "npm"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/ui.git"
  },
  "homepage": "https://github.com/link-foundation/ui#readme",
  "bugs": {
    "url": "https://github.com/link-foundation/ui/issues"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "command-stream": "2.4.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jscpd": "^5.4.0",
    "links-notation": "^0.27.1",
    "lino-arguments": "0.4.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "test-anywhere": "^0.8.48"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write",
      "prettier --check"
    ],
    "*.md": [
      "prettier --write",
      "prettier --check"
    ],
    "*.sh": [
      "pipx run --spec shellcheck-py==0.11.0.1 shellcheck"
    ],
    ".husky/*": [
      "pipx run --spec shellcheck-py==0.11.0.1 shellcheck"
    ]
  }
}
