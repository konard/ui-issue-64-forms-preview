{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/link-foundation/ui/blob/main/docs/spec/element-tree.schema.json",
  "title": "ui-dialect/0 conformance fixture",
  "description": "Expected output of a ui-dialect/0 fixture: an element tree (<name>.tree.json) or a list of diagnostics only (<name>.diagnostics.json).",
  "oneOf": [{ "$ref": "#/$defs/tree" }, { "$ref": "#/$defs/diagnosticsOnly" }],
  "$defs": {
    "spec": { "const": "ui-dialect/0" },
    "tree": {
      "type": "object",
      "required": ["spec", "elements", "diagnostics"],
      "additionalProperties": false,
      "properties": {
        "spec": { "$ref": "#/$defs/spec" },
        "elements": {
          "type": "array",
          "items": { "$ref": "#/$defs/element" }
        },
        "unknown": {
          "type": "array",
          "items": { "$ref": "#/$defs/value" }
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      }
    },
    "diagnosticsOnly": {
      "type": "object",
      "required": ["spec", "diagnostics"],
      "additionalProperties": false,
      "properties": {
        "spec": { "$ref": "#/$defs/spec" },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      }
    },
    "element": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "positional",
        "properties",
        "children",
        "unknown"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": ["string", "null"] },
        "kind": { "type": ["string", "null"] },
        "positional": {
          "type": "array",
          "items": { "$ref": "#/$defs/value" }
        },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/property" }
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/element" }
        },
        "unknown": {
          "type": "array",
          "items": { "$ref": "#/$defs/value" }
        }
      }
    },
    "property": {
      "type": "object",
      "required": ["name", "values"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "values": {
          "type": "array",
          "items": { "$ref": "#/$defs/value" }
        }
      }
    },
    "value": {
      "description": "A reference atom is a string; a nested link without an id is an array; a nested link with an id is an object.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/value" }
        },
        {
          "type": "object",
          "required": ["id", "values"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "values": {
              "type": "array",
              "items": { "$ref": "#/$defs/value" }
            }
          }
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "at"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "syntax-error",
            "depth-exceeded",
            "input-too-large",
            "missing-kind",
            "unknown-kind",
            "unknown-sublink",
            "unexpected-child",
            "duplicate-id",
            "duplicate-property",
            "reserved-sigil",
            "invalid-value",
            "reference-cycle",
            "invalid-handler",
            "unknown-action",
            "unsafe-url"
          ]
        },
        "severity": { "enum": ["error", "warning", "info"] },
        "at": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "line": { "type": "integer", "minimum": 1 },
            "column": { "type": "integer", "minimum": 1 },
            "element": { "type": ["string", "null"] },
            "kind": { "type": "string" },
            "property": { "type": "string" },
            "head": { "type": ["string", "null"] },
            "token": { "type": "string" }
          }
        }
      }
    }
  }
}
